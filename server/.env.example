# Google AI Studio API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=

# Model to use for Live Multimodal Audio
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Model to use for Fast Chat / Fallback
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Voice name for Live Audio (Options: Aoede, Puck, Charon, Kore, Fenrir)
VOICE_NAME=Aoede

PORT=8000
HOST=0.0.0.0
