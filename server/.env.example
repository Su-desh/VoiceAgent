# Google AI Studio API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=

# Model to use for Live Multimodal Audio (gemini-2.0-flash-exp)
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Model to use for Fast Chat / Fallback (gemini-2.0-flash)
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Voice name for Live Audio (Options: Aoede, Puck, Charon, Kore, Fenrir)
VOICE_NAME=Aoede

PORT=8000
HOST=0.0.0.0
