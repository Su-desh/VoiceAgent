# ========================================================
# Shubh Diwali AI Voice Agent - Unified Environment Config
# ========================================================

# 1. Backend Server (server/.env)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=0.0.0.0

# 2. Frontend Client (client/.env.local or Vercel Environment Variables)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# Production deployment (e.g. Render / Railway):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com/ws/live
